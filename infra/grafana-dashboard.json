{
  "dashboard": {
    "title": "AI Financial Advisor",
    "tags": ["ai-financial-advisor"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "HTTP Request Rate",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])",
            "legendFormat": "{{method}} {{endpoint}} {{status}}"
          }
        ],
        "xaxis": {"mode": "time"},
        "yaxis": {"format": "reqps"}
      },
      {
        "id": 2,
        "title": "HTTP Request Latency (p95)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "{{method}} {{endpoint}}"
          }
        ],
        "xaxis": {"mode": "time"},
        "yaxis": {"format": "s"}
      },
      {
        "id": 3,
        "title": "Orchestration Rate",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "rate(orchestration_total[5m])",
            "legendFormat": "{{query_type}}"
          }
        ],
        "xaxis": {"mode": "time"},
        "yaxis": {"format": "ops"}
      },
      {
        "id": 4,
        "title": "Orchestration Latency (p95)",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(orchestration_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          }
        ],
        "xaxis": {"mode": "time"},
        "yaxis": {"format": "s"}
      },
      {
        "id": 5,
        "title": "Agent Confidence Scores",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "agent_confidence",
            "legendFormat": "{{agent}}"
          }
        ],
        "xaxis": {"mode": "time"},
        "yaxis": {"format": "percentunit", "max": 1}
      },
      {
        "id": 6,
        "title": "Active Connections",
        "type": "graph",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "active_connections",
            "legendFormat": "connections"
          }
        ],
        "xaxis": {"mode": "time"},
        "yaxis": {"format": "short"}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s"
  },
  "overwrite": true
}